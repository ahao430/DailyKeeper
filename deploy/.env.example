# DailyKeeper 环境变量（复制为 deploy/.env 使用）
DAILYKEEPER_ENV=prod
# 生产必须修改为长随机串（openssl rand -hex 32）
DAILYKEEPER_SECRET_KEY=please-change-me-openssl-rand-hex-32
DAILYKEEPER_ADMIN_USERNAME=admin
DAILYKEEPER_ADMIN_PASSWORD=admin123
DAILYKEEPER_TIMEZONE=Asia/Shanghai
# 浏览器 Worker（Playwright）：容器内保持无头模式；更多 DAILYKEEPER_BROWSER_* 变量见 docs/DEPLOYMENT.md
DAILYKEEPER_BROWSER_HEADLESS=true
